# OccuPi local stack — this file is committed on purpose: it contains no secrets,
# only working local defaults. `docker compose up -d --build` runs as-is.

# ── The one value you are expected to touch ─────────────────────────────────
# Which rooms the simulated Raspberry Pis feed, as roomId:capacity pairs.
# One virtual Pi per entry (sensorId mock-pi-<roomId>); the backend seeds the
# same rooms into Postgres at startup, so the dashboard shows them immediately.
MOCK_ROOMS=006:20,011:15,137:30

# ── Everything below has working defaults — uncomment only to override ──────

# Full auth flow instead of the open dev profile. After changing this, rebuild:
#   docker compose up -d --build backend
# Login: occupi-admin / occupi-admin (seeded test admin), occupi-user / occupi-user,
# or your HdM account when ldap.hdm-stuttgart.de is reachable (HdM network/VPN).
# SPRING_PROFILES_ACTIVE=prod

# Simulated data rates (seconds).
# MOCK_OCCUPANCY_INTERVAL=5
# MOCK_METRICS_INTERVAL=30

# Infrastructure credentials — local-only defaults.
# POSTGRES_USER=occupi
# POSTGRES_PASSWORD=occupi
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
