# OccuPi Pi sender — copy to .env and fill in every value:
#   cp .env.example .env
# raspberry/docker/.env is git-ignored. The compose file refuses to start with
# missing values, so a half-configured Pi never feeds a phantom room.

# Room this Pi's data lands in. MUST match a room id in the admin panel — the
# backend treats it as a claim: matches a room → data flows immediately; typo →
# the Pi shows up as "ungeklärt" in the admin panel and can be assigned there.
ROOM_ID=137

# Stable device name for this Pi — how the admin panel addresses it, and the
# key its health metrics are stored under. Pick something physical and keep it
# for the Pi's lifetime (renaming splits the metrics history).
SENSOR_ID=pi-137

# Radar unit: the serial number in the USB by-id path of the CP2105 bridge.
#   ls -l /dev/serial/by-id/
# → usb-Silicon_Labs_CP2105_Dual_USB_to_UART_Bridge_Controller_<THIS>-if00-port0
RADAR_SERIAL=010BCEBF

# Backend endpoint. Production goes through nginx: host + 443 + TLS on.
BACKEND_HOST=occupi.mi.hdm-stuttgart.de
BACKEND_PORT=443
BACKEND_TLS=true

# Optional: CA bundle path for a non-Let's-Encrypt backend certificate.
# BACKEND_TLS_CA=
